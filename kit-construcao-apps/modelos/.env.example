# Copie para .env.local e preencha. Este arquivo vai para o git SEM valores.

# Vão para o navegador: só a URL e a chave publicável levam NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Só no servidor e nos scripts. Nunca com NEXT_PUBLIC_, nunca no CI, nunca no chat.
SUPABASE_SECRET_KEY=
